# GEMINI_API_KEY: Required for optional AI features if configured.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# BUSINESS_TIMEZONE: Explicit business timezone for Daily Ops Report boundary resolution (default: Asia/Kolkata)
BUSINESS_TIMEZONE="Asia/Kolkata"

# DEFAULT_SPREADSHEET_ID: Optional default read-only Google Sheet ID for Task Raw & Scanning
DEFAULT_SPREADSHEET_ID=""

# TASK_RAW_SHEET_NAME: Worksheet tab name for Task Raw records (columns B, D, K, N, O, AS..AX)
TASK_RAW_SHEET_NAME="Task Raw"

# SCANNING_SHEET_NAME: Worksheet tab name for Meal Scanning records (columns C..G)
SCANNING_SHEET_NAME="Scanning"

# ADMIN_EMAILS: Comma-separated list of authorized Administrator email addresses
ADMIN_EMAILS="onkar.jagtap@aaalay.com"

# ANALYST_EMAILS: Comma-separated list of authorized Analyst email addresses
ANALYST_EMAILS=""

# ALLOWED_CORS_ORIGINS: Comma-separated allowed origins for strict CORS validation
ALLOWED_CORS_ORIGINS="http://localhost:3000"

